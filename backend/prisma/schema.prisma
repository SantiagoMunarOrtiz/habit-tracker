// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   @default("")
  name      String?
  level     Int      @default(1)
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories   Category[]
  habits       Habit[]
  goals        Goal[]
  userRewards  UserReward[]
  userAchievements UserAchievement[]
  vacations    Vacation[]
}

model Category {
  id     String @id @default(uuid())
  name   String // "Personal", "Work", "Study"
  color  String
  userId String
  user   User   @relation(fields: [userId], references: [id])

  habits Habit[]

  @@unique([name, userId])
}

model Habit {
  id          String   @id @default(uuid())
  title       String
  description String?
  
  // V2 Core
  planType    String   @default("Personal") // "Work", "Study", "Personal"
  difficulty  String   @default("Medium") // "Easy", "Medium", "Hard"
  
  // V2 Scheduling
  scheduleType      String   @default("daily") // "daily", "fixedDays", "flexible"
  selectedDays      String?  // JSON string e.g., "[1,3,5]" (Mon, Wed, Fri) - for fixedDays
  targetDaysPerWeek Int?     // e.g., 4 - for flexible
  restDays          String?  // JSON string e.g., "[0,6]" (Sun, Sat)
  
  // V2 Behavioral Science
  timeOfDay         String?  // "morning", "afternoon", "evening", "any"
  estimatedDuration Int?     // in minutes
  triggerCue        String?
  ifThenPlan        String?
  motivationPhrase  String?
  miniReward        String?
  
  startDate   DateTime @default(now())
  endDate     DateTime?
  active      Boolean  @default(true)
  isArchived  Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  logs         HabitLog[]
  reschedules  HabitReschedule[]
  achievements HabitAchievement[]
}

model HabitLog {
  id        String   @id @default(uuid())
  date      String   // YYYY-MM-DD format for easier querying
  status    String   // "completed", "skipped", "failed", "rest", "rescheduled", "vacation"
  note      String?
  createdAt DateTime @default(now())

  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id])

  @@unique([habitId, date])
}

model HabitReschedule {
  id           String   @id @default(uuid())
  originalDate String   // YYYY-MM-DD
  newDate      String   // YYYY-MM-DD
  createdAt    DateTime @default(now())

  habitId      String
  habit        Habit    @relation(fields: [habitId], references: [id])
}

model Vacation {
  id        String   @id @default(uuid())
  startDate String   // YYYY-MM-DD
  endDate   String   // YYYY-MM-DD
  appliesTo String   @default("All") // "All", "Personal", "Work"
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Goal {
  id         String   @id @default(uuid())
  title      String
  targetDate DateTime?
  status     String   @default("active") // "active", "completed", "abandoned"
  createdAt  DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id])
}

model Reward {
  id          String   @id @default(uuid())
  name        String
  icon        String
  description String
  criteria    String

  userRewards UserReward[]
}

model UserReward {
  id         String   @id @default(uuid())
  dateEarned DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id])
  rewardId   String
  reward     Reward   @relation(fields: [rewardId], references: [id])

  @@unique([userId, rewardId])
}

model Achievement {
  id              String @id @default(uuid())
  name            String
  description     String
  unlockCondition String // e.g., "7_DAY_STREAK", "FIRST_FULL_WEEK"
  points          Int
  miniReward      String?
  message         String?
  
  userAchievements UserAchievement[]
}

model UserAchievement {
  id         String   @id @default(uuid())
  dateEarned DateTime @default(now())

  userId        String
  user          User        @relation(fields: [userId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

model HabitAchievement {
  id              String   @id @default(uuid())
  habitId         String
  habit           Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  
  achievementType String   // e.g., "1_COMPLETION", "3_COMPLETION", "66_COMPLETION"
  name            String
  description     String
  
  dateEarned      DateTime @default(now())

  @@unique([habitId, achievementType])
}
